{
  "__prompts__": {
    "project_name": "Project name",
    "artifact_id": "Artifact id",
    "group_id": "Group id",
    "package_name": "Base Java package",
    "plugin_display_name": "Plugin display name",
    "main_class_name": "Main plugin class name",
    "description": "Plugin description",
    "author": "Author",
    "mindustry_version": "Mindustry version",
    "xcore_plugin_version": "XCore-plugin version",
    "flubundle_version": "FluBundle version",
    "use_xcore_plugin": "Depend on XCore-plugin?",
    "use_flubundle": "Depend on FluBundle?"
  },
  "_jinja2_env_vars": {
    "trim_blocks": true,
    "lstrip_blocks": true
  },
  "_copy_without_render": [
    "*/gradlew",
    "*/gradlew.bat",
    "*/gradle/wrapper/*"
  ],
  "project_name": "MyPlugin",
  "artifact_id": "{{ cookiecutter.project_name.lower().replace(' ', '-').replace('_', '-') }}",
  "group_id": "org.xcore.plugin",
  "package_name": "{{ cookiecutter.group_id }}.{{ cookiecutter.artifact_id.replace('-', '') }}",
  "plugin_display_name": "{{ cookiecutter.project_name }}",
  "main_class_name": "{{ cookiecutter.project_name.replace('-', ' ').replace('_', ' ').title().replace(' ', '') }}Plugin",
  "description": "A Mindustry plugin for XCore servers.",
  "author": "XCore Team",
  "mindustry_version": "159",
  "xcore_plugin_version": "4.2.1",
  "flubundle_version": "1.6",
  "use_xcore_plugin": true,
  "use_flubundle": true,
  "__project_slug": "{{ cookiecutter.artifact_id }}",
  "__package_path": "{{ cookiecutter.package_name.replace('.', '/') }}",
  "__main_class_fqcn": "{{ cookiecutter.package_name }}.{{ cookiecutter.main_class_name }}",
  "__flubundle_scope": "{% if cookiecutter.use_xcore_plugin and cookiecutter.use_flubundle %}compileOnly{% elif cookiecutter.use_flubundle %}implementation{% else %}compileOnly{% endif %}"
}
